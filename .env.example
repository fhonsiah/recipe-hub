# Django secret key. Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Debug mode. Keep False in production.
DEBUG=False

# Comma-separated list of allowed hosts, e.g. example.com,www.example.com
ALLOWED_HOSTS=example.com

# Database configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=recipehub
DB_USER=recipehub
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Comma-separated origins allowed to submit CSRF-protected requests, e.g. https://recipehub.example.com
CSRF_TRUSTED_ORIGINS=

# Set to 0 to disable the HTTPS redirect during the first deploy
SECURE_SSL_REDIRECT=1
